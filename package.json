{
  "name": "ghostwriter",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "overrides": {
    "js-yaml": "4.3.2",
    "@huggingface/transformers": {
      "sharp": "0.35.4"
    }
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 8080",
    "build": "node --import tsx scripts/build-guide.mjs && vite build && node scripts/build-offline.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test scripts/*.test.mjs tests/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:browser": "node scripts/ghostwriter-browser.mjs http://127.0.0.1:8081",
    "test:recovery": "node scripts/ghostwriter-recovery.mjs http://127.0.0.1:8081",
    "test:iphone": "node scripts/ghostwriter-iphone.mjs",
    "test:cloudflare": "node --import tsx --test tests/access.test.ts tests/online-help.test.ts",
    "test:production": "node scripts/ghostwriter-production.mjs",
    "cf:typegen": "wrangler types",
    "test:polish": "node scripts/ghostwriter-polish.mjs",
    "guide:pdf": "node scripts/print-guide.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "6.2.12",
    "lucide-react": "^0.510.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.61.0",
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.15.0",
    "playwright": "^1.62.0",
    "prettier": "^3.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.2.0",
    "wrangler": "4.142.0",
    "@tailwindcss/vite": "^4.3.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.3.4",
    "miniflare": "5.20260926.0-alpha"
  },
  "version": "4.0.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
